# Gem.AI · variáveis de exemplo
#
# IMPORTANTE: o front-end roda 100% estático no GitHub Pages.
# A GROQ_API_KEY NUNCA fica no navegador nem em variáveis VITE_/NEXT_PUBLIC_.
# Ela é um SECRET da Edge Function no Supabase:
#
#   supabase secrets set GROQ_API_KEY=gsk_sua_chave
#
# Este arquivo existe para quem usa o CLI do Supabase / scripts locais.
# A chave real JÁ está configurada como secret no projeto (não precisa preencher aqui).

# Chave da Groq (https://console.groq.com/keys) — somente backend/CLI
GROQ_API_KEY=gsk_cole_sua_chave_aqui

# Token exigido no POST da Edge Function (já configurado como secret no Supabase
# e com o valor padrão em docs/js/config.js). NÃO é uma credencial secreta:
# o site é público, então ele é apenas uma barreira contra uso casual da URL.
# GEM_CHAT_TOKEN=cole_aqui_se_quiser_rotacionar

# Dados públicos do projeto (seguros para o navegador)
SUPABASE_URL=https://jikizafsbrclkfgoccha.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Cq2BWkiQP5fLu6z9J-403g_REk8WCPd
SUPABASE_PROJECT_REF=jikizafsbrclkfgoccha

# Storage dos anexos (bucket PRIVADO, criado pela migration gem_ai_files).
# O navegador usa só a publishable key + o header x-gem-owner; RLS isola por dono.
# O bucket aceita 1 GiB por objeto, mas o limite GLOBAL do plano Free é 50 MiB:
# é esse número que vai em CONFIG.maxFileBytes. Com plano Pro, suba o limite global
# no Storage Settings e troque para 1073741824 (1 GiB) ou mais.
GEM_STORAGE_BUCKET=gem-uploads
GEM_MAX_FILE_BYTES=52428800

# Nunca coloque a SERVICE_ROLE_KEY aqui ou no front-end.
